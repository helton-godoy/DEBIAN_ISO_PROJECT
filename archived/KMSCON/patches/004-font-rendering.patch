+		kmscon_font_pango_init();
+
 	/* Setup global environment */
 	setenv("XDG_SESSION_TYPE", "tty", 1);
 	if (!getenv("TERM"))
--- a/docs/kmscon.1
+++ b/docs/kmscon.1
@@ -89,6 +89,20 @@ Font size in points.
 Default: 12
 .RE
 
+.TP
+.B font\-subpixel=<mode>
+Subpixel rendering mode: rgb, bgr, vrgb, vbgr, none.
+Improves font clarity on LCD displays.
+Default: rgb (auto-detected from fontconfig)
+.RE
+
+.TP
+.B font\-hires=<bool>
+Enable high-resolution rendering for HiDPI displays.
+Automatically scales fonts based on GDK_SCALE or QT_SCALE_FACTOR.
+Default: true
+.RE
+
 .SH FILES
 .TP
 .I /etc/kmscon/kmscon.conf

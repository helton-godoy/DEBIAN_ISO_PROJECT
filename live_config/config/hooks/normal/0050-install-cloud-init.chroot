#!/bin/bash
# =============================================================================
# Hook Chroot: Instalação do Cloud-Init e Dependências
# =============================================================================
# Descrição: Instala cloud-init, qemu-guest-agent e configura datasource nocloud
# Prioridade: 0050 (antes do hook de usuário e após pacotes base)
# =============================================================================

set -euo pipefail

readonly HOOK_NAME="install-cloud-init"

log_info() {
    echo "[$HOOK_NAME] [INFO] $1"
}

log_warn() {
    echo "[$HOOK_NAME] [WARN] $1" >&2
}

log_error() {
    echo "[$HOOK_NAME] [ERROR] $1" >&2
}

# =============================================================================
# INSTALAÇÃO DE PACOTES
# =============================================================================

install_packages() {
    log_info "Instalando cloud-init e dependências..."
    
    # Atualiza lista de pacotes
    apt-get update
    
    # Instala pacotes necessários
    apt-get install -y --no-install-recommends \
        cloud-init \
        cloud-guest-utils \
        qemu-guest-agent \
        openssh-server
    
    log_info "Pacotes instalados com sucesso"
}

# =============================================================================
# CONFIGURAÇÃO DO DATASOURCE NOCLOUD
# =============================================================================

configure_datasource() {
    log_info "Configurando datasource nocloud..."
    
    # Cria diretório de configuração do cloud-init
    mkdir -p /etc/cloud/cloud.cfg.d
    
    # Configura datasource nocloud como primário
    cat > /etc/cloud/cloud.cfg.d/90_dpkg.cfg << 'EOF'
# Datasource configuration for cloud-init
# Generated by live-build hook 0050-install-cloud-init

datasource_list: [ NoCloud, None ]
datasource:
  NoCloud:
    seedfrom: /cdrom/nocloud/
EOF

    log_info "Datasource nocloud configurado"
}

# =============================================================================
# HABILITAÇÃO DE SERVIÇOS
# =============================================================================

enable_services() {
    log_info "Habilitando serviços cloud-init e qemu-guest-agent..."
    
    # Serviços do cloud-init
    local cloud_services=(
        "cloud-init-local"
        "cloud-init"
        "cloud-config"
        "cloud-final"
    )
    
    for service in "${cloud_services[@]}"; do
        if systemctl list-unit-files "${service}.service" &>/dev/null; then
            log_info "Habilitando serviço: $service"
            systemctl enable "$service" || log_warn "Não foi possível habilitar $service"
        else
            log_warn "Serviço não encontrado: $service"
        fi
    done
    
    # Habilita qemu-guest-agent
    if systemctl list-unit-files "qemu-guest-agent.service" &>/dev/null; then
        log_info "Habilitando serviço: qemu-guest-agent"
        systemctl enable qemu-guest-agent || log_warn "Não foi possível habilitar qemu-guest-agent"
    else
        log_warn "Serviço qemu-guest-agent não encontrado"
    fi
    
    # Habilita SSH
    if systemctl list-unit-files "ssh.service" &>/dev/null; then
        log_info "Habilitando serviço: ssh"
        systemctl enable ssh || log_warn "Não foi possível habilitar ssh"
    fi
    
    log_info "Serviços habilitados"
}

# =============================================================================
# OTIMIZAÇÃO DE BOOT
# =============================================================================

optimize_boot() {
    log_info "Otimizando tempo de boot do cloud-init..."
    
    # Desabilita datasources desnecessários para acelerar o boot
    cat > /etc/cloud/cloud.cfg.d/99-disable-unused-datasources.cfg << 'EOF'
# Disable unused datasources to speed up boot
datasource_list: [ NoCloud, None ]
EOF

    log_info "Otimização de boot concluída"
}

# =============================================================================
# CONFIGURAÇÃO DE REDE
# =============================================================================

configure_network() {
    log_info "Configurando suporte a rede para cloud-init..."
    
    # Garante que o NetworkManager não conflite com cloud-init
    # em sistemas live, preferimos network-manager
    if systemctl list-unit-files "NetworkManager.service" &>/dev/null; then
        log_info "NetworkManager detectado - configurando compatibilidade"
        cat > /etc/cloud/cloud.cfg.d/99-network-manager.cfg << 'EOF'
# Use NetworkManager for network configuration
network:
  config: disabled
EOF
    fi
    
    log_info "Configuração de rede concluída"
}

# =============================================================================
# FUNÇÃO PRINCIPAL
# =============================================================================

main() {
    echo "================================================"
    echo "Hook Chroot: Instalação do Cloud-Init"
    echo "================================================"
    
    log_info "Iniciando instalação e configuração do cloud-init..."
    
    # 1. Instala pacotes
    install_packages
    
    # 2. Configura datasource nocloud
    configure_datasource
    
    # 3. Habilita serviços
    enable_services
    
    # 4. Otimiza boot
    optimize_boot
    
    # 5. Configura rede
    configure_network
    
    log_info "Configuração do cloud-init concluída com sucesso"
    
    echo "================================================"
    echo "Cloud-Init instalado e configurado"
    echo "  - Datasource: nocloud"
    echo "  - Serviços habilitados: cloud-init*, qemu-ga, ssh"
    echo "================================================"
    
    exit 0
}

# Executa main
main "$@"

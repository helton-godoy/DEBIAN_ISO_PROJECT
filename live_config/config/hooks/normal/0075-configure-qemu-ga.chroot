#!/bin/bash
# =============================================================================
# Hook Chroot: Configuração do Qemu-Guest-Agent
# =============================================================================
# Descrição: Configura qemu-guest-agent com canal virtio-serial
# Prioridade: 0075 (após instalação do cloud-init, antes do usuário)
# =============================================================================

set -euo pipefail

readonly HOOK_NAME="configure-qemu-ga"
readonly VIRTIO_PORT="/dev/virtio-ports/org.qemu.guest_agent.0"

log_info() {
    echo "[$HOOK_NAME] [INFO] $1"
}

log_warn() {
    echo "[$HOOK_NAME] [WARN] $1" >&2
}

log_error() {
    echo "[$HOOK_NAME] [ERROR] $1" >&2
}

# =============================================================================
# CONFIGURAÇÃO DO DIRETÓRIO VIRTIO-PORTS
# =============================================================================

setup_virtio_ports() {
    log_info "Configurando diretório virtio-ports..."
    
    # Cria diretório para virtio-ports (será populado pelo kernel em runtime)
    mkdir -p /dev/virtio-ports
    
    log_info "Diretório virtio-ports criado"
}

# =============================================================================
# CONFIGURAÇÃO DO SERVIÇO SYSTEMD
# =============================================================================

configure_systemd_service() {
    log_info "Configurando serviço systemd do qemu-guest-agent..."
    
    # Cria diretório para overrides do systemd
    mkdir -p /etc/systemd/system/qemu-guest-agent.service.d
    
    # Cria override simples apenas para garantir que o serviço inicie
    # O pacote padrão já configura o virtio-serial corretamente
    cat > /etc/systemd/system/qemu-guest-agent.service.d/override.conf << 'EOF'
[Unit]
# Aguarda o dispositivo virtio-serial estar disponível
After=dev-virtio\x2dports-org.qemu.guest_agent.0.device
Wants=dev-virtio\x2dports-org.qemu.guest_agent.0.device

[Service]
# Restart automático se falhar
Restart=on-failure
RestartSec=5
EOF

    # Recarrega daemon systemd (em chroot, isso pode falhar silenciosamente)
    systemctl daemon-reload 2>/dev/null || true
    
    log_info "Serviço systemd configurado"
}

# =============================================================================
# CONFIGURAÇÃO ALTERNATIVA (SYSVINIT)
# =============================================================================

configure_sysvinit() {
    log_info "Configurando init script alternativo..."
    
    # Cria diretório para configuração
    mkdir -p /etc/default
    
    # Configuração do qemu-ga para init scripts
    cat > /etc/default/qemu-guest-agent << EOF
# QEMU Guest Agent configuration
# Generated by live-build hook 0075-configure-qemu-ga

# Method of communication with the host
GA_METHOD=virtio-serial

# Path to the virtio-serial device
GA_PATH=${VIRTIO_PORT}

# Additional options
GA_OPTIONS="--daemonize --pidfile=/var/run/qemu-ga.pid"
EOF

    log_info "Configuração sysvinit criada"
}

# =============================================================================
# CONFIGURAÇÃO DE PERMISSÕES
# =============================================================================

setup_permissions() {
    log_info "Configurando permissões..."
    
    # Cria o arquivo de log do qemu-ga com permissões adequadas
    touch /var/log/qemu-ga.log 2>/dev/null || true
    chmod 640 /var/log/qemu-ga.log 2>/dev/null || true
    
    # Cria diretório para o pidfile
    mkdir -p /var/run 2>/dev/null || true
    
    log_info "Permissões configuradas"
}

# =============================================================================
# CONFIGURAÇÃO DE UDEV (REGRAS PARA VIRTIO-PORTS)
# =============================================================================

configure_udev() {
    log_info "Configurando regras udev para virtio-ports..."
    
    # Cria regra udev para garantir permissões corretas no dispositivo virtio
    cat > /etc/udev/rules.d/99-qemu-guest-agent.rules << 'EOF'
# QEMU Guest Agent - VirtIO Serial Port
# Garante permissões corretas para o canal de comunicação

# VirtIO port para qemu-ga
SUBSYSTEM=="virtio-ports", ATTR{name}=="org.qemu.guest_agent.0", TAG+="systemd", SYMLINK+="virtio-ports/org.qemu.guest_agent.0"

# Permissões para o dispositivo
KERNEL=="vport*", ATTR{name}=="org.qemu.guest_agent.0", MODE="0660", GROUP="kvm"
EOF

    log_info "Regras udev configuradas"
}

# =============================================================================
# VERIFICAÇÃO DE INSTALAÇÃO
# =============================================================================

verify_installation() {
    log_info "Verificando instalação do qemu-guest-agent..."
    
    # Verifica se o binário existe
    if [[ -x /usr/sbin/qemu-ga ]]; then
        log_info "Binário qemu-ga encontrado: $(/usr/sbin/qemu-ga --version 2>&1 | head -1 || echo 'versão desconhecida')"
    else
        log_warn "Binário qemu-ga não encontrado em /usr/sbin/qemu-ga"
    fi
    
    # Verifica se o módulo virtio-serial está disponível
    if [[ -d /lib/modules/$(uname -r)/kernel/drivers/virtio ]] || \
       [[ -d /lib/modules/*/kernel/drivers/virtio ]] 2>/dev/null; then
        log_info "Módulos virtio disponíveis no kernel"
    else
        log_warn "Módulos virtio podem não estar disponíveis (kernel pode ser diferente em runtime)"
    fi
    
    log_info "Verificação concluída"
}

# =============================================================================
# FUNÇÃO PRINCIPAL
# =============================================================================

main() {
    echo "================================================"
    echo "Hook Chroot: Configuração do Qemu-Guest-Agent"
    echo "================================================"
    
    log_info "Iniciando configuração do qemu-guest-agent..."
    
    # 1. Configura diretório virtio-ports
    setup_virtio_ports
    
    # 2. Configura serviço systemd
    configure_systemd_service
    
    # 3. Configura sysvinit (fallback)
    configure_sysvinit
    
    # 4. Configura permissões
    setup_permissions
    
    # 5. Configura udev
    configure_udev
    
    # 6. Verifica instalação
    verify_installation
    
    log_info "Configuração do qemu-guest-agent concluída com sucesso"
    
    echo "================================================"
    echo "Qemu-Guest-Agent configurado"
    echo "  - Canal: virtio-serial"
    echo "  - Device: ${VIRTIO_PORT}"
    echo "  - Serviço: habilitado"
    echo "================================================"
    
    exit 0
}

# Executa main
main "$@"

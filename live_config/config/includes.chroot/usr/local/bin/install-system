# STRICT MODE E CONFIGURAÇÕES DE SEGURANÇA
# ═══════════════════════════════════════════════════════════════════════════════

set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true

# Verificar versão do Bash (requer 4+ para features utilizadas)
[[ ${BASH_VERSINFO[0]} -ge 4 ]] || {
	printf '%s\n' "Erro: Bash 4+ é necessário" >&2
	exit 1
}

# ═══════════════════════════════════════════════════════════════════════════════
# VARIÁVEIS GLOBAIS E CONSTANTES
# ═══════════════════════════════════════════════════════════════════════════════

# Flag de modo simulação
readonly MOCK_MODE=false

# Flag de modo automático (não-interativo)
declare AUTO_MODE=false

# Variável global para modo de boot (UEFI/BIOS)
declare BOOT_MODE=""

# Forçar suporte a cores para terminais que não reportam corretamente
export COLORTERM="truecolor"
export TERM="${TERM:-xterm-256color}"

# Pool ZFS
readonly POOL_NAME="zroot"

# Arquivo de log
readonly LOG_FILE="/var/log/install-system.log"
readonly LOG_DIR="/var/log"
readonly ZFS_OPTS="-o ashift=12 -O compression=lz4 -O acltype=posixacl -O xattr=sa -O dnodesize=auto -O normalization=formD -O mountpoint=none -O canmount=off -O devices=off"

# ═══════════════════════════════════════════════════════════════════════════════
# FUNÇÕES DE LOGGING
# ═══════════════════════════════════════════════════════════════════════════════

# Inicializa sistema de logging
init_logging() {
	# Criar diretório de log se não existir
	if [[ ! -d ${LOG_DIR} ]]; then
		mkdir -p "${LOG_DIR}" 2>/dev/null || {
			printf '%s\n' "ERRO: Não foi possível criar diretório: ${LOG_DIR}" >&2
			return 1
		}
	fi

	# Inicializar arquivo de log
	printf '%s\n' "=== Instalador AURORA - Iniciado em $(date '+%Y-%m-%d %H:%M:%S') ===" >"${LOG_FILE}"
	printf '%s\n' "Modo: ${BOOT_MODE} | Auto: ${AUTO_MODE} | Pool: ${POOL_NAME}" >>"${LOG_FILE}"
	printf '%s\n' "=============================================================" >>"${LOG_FILE}"

	return 0
}

# Log com timestamp
log_with_timestamp() {
	local level="$1"
	local message="$2"
	local timestamp
	timestamp=$(date '+%Y-%m-%d %H:%M:%S')
	printf '[%s] [%s] %s\n' "${timestamp}" "${level}" "${message}" >>"${LOG_FILE}"
}

# Log nível INFO
log_info() {
	log_with_timestamp "INFO" "$1"
}

# Log nível WARN
log_warn() {
	log_with_timestamp "WARN" "$1"
}

# Log nível ERROR
log_error() {
	log_with_timestamp "ERRO" "$1"
}

# Log nível DEBUG
log_debug() {
	[[ ${DEBUG:-0} == "1" ]] && log_with_timestamp "DEBUG" "$1"
}

# Log de passo/etapa
log_step() {
	local step_num="$1"
	local total="$2"
	local message="$3"
	log_with_timestamp "PASSO" "[${step_num}/${total}] ${message}"
}

# Log de comando executado
log_cmd() {
	local cmd="$*"
	log_with_timestamp "CMD" "${cmd}"
}

# Log de resultado de comando
log_result() {
	local exit_code="$1"
	if [[ ${exit_code} -eq 0 ]]; then
		log_with_timestamp "OK" "Comando executado com sucesso"
	else
		log_with_timestamp "FALHA" "Comando falhou com código: ${exit_code}"
	fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# AURORA DESIGN SYSTEM v2.0 - PALETA MONOCROMÁTICA SLATE
# ═══════════════════════════════════════════════════════════════════════════════

# Fundos e superfícies
# ═══════════════════════════════════════════════════════════════════════════════
# FUNÇÕES DE VALIDAÇÃO DE PRÉ-REQUISITOS
# ═══════════════════════════════════════════════════════════════════════════════

# Verifica todos os pré-requisitos antes de iniciar instalação
check_prerequisites() {
	log_info "Verificando pré-requisitos do sistema..."

	local -a missing_deps=()
	local -a required_deps=(
		"gum" "lsblk" "sgdisk" "zpool" "zfs" "unsquashfs" "mkfs.vfat"
		"partprobe" "blkid" "zgenhostid" "systemd-machine-id-setup"
		"update-initramfs" "useradd" "chpasswd" "modprobe" "wipefs"
	)

	# Verificar dependências essenciais
	log_info "Verificando dependências..."
	for dep in "${required_deps[@]}"; do
		if ! command -v "${dep}" &>/dev/null; then
			missing_deps+=("${dep}")
			log_error "Dependência não encontrada: ${dep}"
		else
			log_info "Dependência OK: ${dep}"
		fi
	done

	if [[ ${#missing_deps[@]} -gt 0 ]]; then
		log_error "Dependências ausentes: ${missing_deps[*]}"
		printf '%s\n' "ERRO: Dependências não encontradas: ${missing_deps[*]}" >&2
		return 1
	fi

	# Verificar arquivos críticos do live system
	log_info "Verificando arquivos do sistema live..."
	local squashfs_paths=(
		"/run/live/medium/live/filesystem.squashfs"
		"/lib/live/mount/medium/live/filesystem.squashfs"
		"/cdrom/live/filesystem.squashfs"
	)

	local SQUASHFS_FOUND=""
	for path in "${squashfs_paths[@]}"; do
		if [[ -f ${path} ]]; then
			SQUASHFS_FOUND="${path}"
			log_info "SquashFS encontrado em: ${path}"
			break
		fi
	done

	if [[ -z ${SQUASHFS_FOUND} ]]; then
		log_error "Imagem SquashFS não encontrada em nenhum local padrão"
		printf '%s\n' "ERRO: filesystem.squashfs não encontrado" >&2
		return 1
	fi

	# Verificar ZFSBootMenu EFI (se UEFI)
	if [[ ${BOOT_MODE} == "UEFI" ]] || [[ -d /sys/firmware/efi ]]; then
		log_info "Verificando ZFSBootMenu EFI..."
		if [[ ! -f "/usr/local/bin/zfsbootmenu.efi" ]]; then
			log_error "ZFSBootMenu EFI não encontrado em /usr/local/bin/zfsbootmenu.efi"
			printf '%s\n' "ERRO: zfsbootmenu.efi não encontrado" >&2
			return 1
		fi
		log_info "ZFSBootMenu EFI OK"
	fi

	# Verificar se estamos em ambiente live
	if [[ ! -d /run/live/medium ]] && [[ ! -d /lib/live/mount ]]; then
		log_warn "Possivelmente não estamos em ambiente live - instalação pode falhar"
	fi

	log_info "Todos os pré-requisitos verificados com sucesso"
	return 0
}

# Detecta o primeiro disco disponível para instalação
detect_first_disk() {
	local -a disk_candidates=()
	local line name

	while IFS= read -r line; do
		[[ -z ${line} ]] && continue
		[[ ${line} == *loop* ]] && continue
		[[ ${line} == *sr* ]] && continue # Skip CD-ROM

		name="${line%% *}"
		# Verificar se é um disco válido (não partição)
		if [[ ! ${name} =~ [0-9]$ ]]; then
			disk_candidates+=("/dev/${name}")
		fi
	done < <(lsblk -dno NAME,SIZE,MODEL 2>/dev/null | grep -v '^loop' | head -5)

	if [[ ${#disk_candidates[@]} -gt 0 ]]; then
		printf '%s' "${disk_candidates[0]}"
		return 0
	fi

	return 1
}

# Verifica espaço disponível no disco
check_disk_space() {
	local disk="$1"
	local required_gb="${2:-20}"

	log_info "Verificando espaço em ${disk} (mínimo: ${required_gb}GB)..."

	if [[ ! -b ${disk} ]]; then
		log_error "Disco não é um device de bloco: ${disk}"
		return 1
	fi

	# Obter tamanho do disco em GB
	local disk_size_bytes
	disk_size_bytes=$(blockdev --getsize64 "${disk}" 2>/dev/null) || {
		log_warn "Não foi possível obter tamanho do disco via blockdev"
		# Fallback para lsblk
		disk_size_bytes=$(lsblk -bndo SIZE "${disk}" 2>/dev/null | head -1)
	}

	if [[ -z ${disk_size_bytes} ]] || [[ ${disk_size_bytes} == "0" ]]; then
		log_error "Não foi possível determinar tamanho do disco: ${disk}"
		return 1
	fi

	local disk_size_gb=$((disk_size_bytes / 1024 / 1024 / 1024))
	log_info "Disco ${disk}: ${disk_size_gb}GB disponíveis"

	if [[ ${disk_size_gb} -lt ${required_gb} ]]; then
		log_error "Disco muito pequeno: ${disk_size_gb}GB (mínimo: ${required_gb}GB)"
		return 1
	fi

	return 0
}

readonly DS_VOID=235      # Profundidade absoluta
readonly DS_DEPTH=237     # Superfície base
readonly DS_ELEVATION=239 # Cards/containers

# Bordas (sutileza progressiva)
readonly DS_WHISPER=240 # Divisores discretos
readonly DS_MIST=243    # Bordas padrão

# Textos (hierarquia de informação)
readonly DS_FOG=245    # Labels secundárias
readonly DS_HAZE=248   # Descrições
readonly DS_CLOUD=250  # Corpo de texto
readonly DS_SILVER=252 # Destaques

# Acentos Slate (matiz principal)
readonly DS_SLATE_DIM=66    # Detalhes técnicos
readonly DS_SLATE=67        # Elementos interativos
readonly DS_SLATE_GLOW=68   # Hover/foco
readonly DS_AURORA_PEAK=153 # Estado ativo (único brilhante)

# Funcionais (uso restrito <5%)
readonly DS_SUCCESS=108 # Sucesso
readonly DS_WARNING=179 # Aviso
readonly DS_ERROR=167   # Erro

# Caracteres UI
readonly UI_H='─'
readonly UI_H_D='═'
readonly UI_ARROW='▶'
readonly UI_BULLET='●'
readonly UI_CHECK='✓'
readonly UI_WARN='⚠'

# ═══════════════════════════════════════════════════════════════════════════════
# FUNÇÕES DE UTILIDADE (PURE BASH)
# ═══════════════════════════════════════════════════════════════════════════════

# Trim leading/trailing whitespace - Pure Bash alternative to sed/awk
trim_string() {
	local tmp="$1"
	tmp="${tmp#"${tmp%%[![:space:]]*}"}"  # Remove leading
	tmp="${tmp%%"${tmp##*[![:space:]]}"}" # Remove trailing
	printf '%s' "${tmp}"
}

# Valida hostname conforme RFC 1123
# Retorna 0 se válido, 1 se inválido
validate_hostname() {
	local hostname="$1"

	# Remove espaços em branco
	hostname=$(trim_string "${hostname}")

	# Verifica se está vazio
	[[ -z ${hostname} ]] && return 1

	# Verifica comprimento máximo (253 caracteres)
	[[ ${#hostname} -gt 253 ]] && return 1

	# Verifica se começa ou termina com hífen
	[[ ${hostname} == -* ]] && return 1
	[[ ${hostname} == *- ]] && return 1

	# Verifica se contém apenas caracteres válidos (a-z, A-Z, 0-9, hífen, ponto)
	if [[ ! ${hostname} =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$ ]]; then
		return 1
	fi

	# Verifica se cada label tem no máximo 63 caracteres
	local IFS='.'
	local -a labels=(${hostname})
	for label in "${labels[@]}"; do
		[[ ${#label} -gt 63 ]] && return 1
	done

	return 0
}

# Check if string contains substring
contains() {
	[[ $1 == *"$2"* ]]
}

# Check if string starts with prefix
starts_with() {
	[[ $1 == "$2"* ]]
}

# Check if string ends with suffix
ends_with() {
	[[ $1 == *"$2" ]]
}

# ═══════════════════════════════════════════════════════════════════════════════
# PARSING DE ARGUMENTOS E MODO AUTO
# ═══════════════════════════════════════════════════════════════════════════════

# Parse argumentos de linha de comando
parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		--auto)
			AUTO_MODE=true
			log_info "Modo automático ativado"
			shift
			;;
		--disk)
			TARGET_DISK="$2"
			log_info "Disco especificado: ${TARGET_DISK}"
			shift 2
			;;
		--user)
			ADM_USER="$2"
			log_info "Usuário especificado: ${ADM_USER}"
			shift 2
			;;
		--password)
			ADM_PASS="$2"
			log_info "Senha fornecida via argumento"
			shift 2
			;;
		--hostname)
			HOSTNAME="$2"
			log_info "Hostname especificado: ${HOSTNAME}"
			shift 2
			;;
		--debug)
			DEBUG=1
			log_info "Modo debug ativado"
			shift
			;;
		--help | -h)
			show_help
			exit 0
			;;
		*)
			printf '%s\n' "Opção desconhecida: $1" >&2
			printf '%s\n' "Use --help para ver as opções disponíveis" >&2
			exit 1
			;;
		esac
	done
}

# Mostrar ajuda
show_help() {
	cat <<EOF
Instalador AURORA - Debian ZFS NAS

USO:
    install-system [OPÇÕES]

OPÇÕES:
    --auto              Modo não-interativo (usa defaults ou variáveis de ambiente)
    --disk DISCO        Especificar disco de destino (ex: /dev/vda)
    --user USUÁRIO      Nome do usuário administrador
    --password SENHA    Senha para usuário e root
    --hostname NOME     Hostname do sistema
    --debug             Ativar logs de debug detalhados
    --help, -h          Mostrar esta ajuda

VARIÁVEIS DE AMBIENTE (usadas quando --auto está ativo):
    TARGET_DISK         Disco de destino (padrão: primeiro disco disponível)
    ADM_USER            Nome do usuário (padrão: admin)
    ADM_PASS            Senha do usuário (padrão: admin)
    HOSTNAME            Hostname (padrão: aurora-nas)

EXEMPLOS:
    # Instalação interativa (padrão)
    sudo install-system

    # Instalação automática
    sudo install-system --auto --disk /dev/vda --user admin --password admin123 --hostname nas-server

    # Usando variáveis de ambiente
    export TARGET_DISK=/dev/vda
    export ADM_USER=admin
    export ADM_PASS=admin123
    export HOSTNAME=nas-server
    sudo install-system --auto

EOF
}

# Extract first field from string (alternative to awk '{print $1}')
first_field() {
	printf '%s' "${1%% *}"
}

# Extract content between parentheses (alternative to awk -F'[()]')
extract_between_parens() {
	local tmp="${1#*\(}"
	printf '%s' "${tmp%\)*}"
}

# Repeat character N times (alternative to seq + printf)
repeat_char() {
	local char="$1"
	local count="$2"
	local result=""
	for ((i = 0; i < count; i++)); do
		result+="${char}"
	done
	printf '%s' "${result}"
}

# Generate horizontal line
h_line() {
	local width="${1:-60}"
	repeat_char "${UI_H}" "${width}"
}

# ═══════════════════════════════════════════════════════════════════════════════
# HANDLERS DE SINAIS E CLEANUP
# ═══════════════════════════════════════════════════════════════════════════════

cleanup() {
	local exit_code=$?

	log_info "Iniciando cleanup (exit code: ${exit_code})"

	# Unmount em ordem reversa se existirem
	if [[ -d /mnt/boot/efi ]]; then
		log_info "Desmontando /mnt/boot/efi"
		umount /mnt/boot/efi 2>/dev/null || log_warn "Falha ao desmontar /mnt/boot/efi"
	fi

	if [[ -d /mnt/dev ]]; then
		log_info "Desmontando /mnt/dev"
		umount /mnt/dev 2>/dev/null || log_warn "Falha ao desmontar /mnt/dev"
	fi

	if [[ -d /mnt/proc ]]; then
		log_info "Desmontando /mnt/proc"
		umount /mnt/proc 2>/dev/null || log_warn "Falha ao desmontar /mnt/proc"
	fi

	if [[ -d /mnt/sys ]]; then
		log_info "Desmontando /mnt/sys"
		umount /mnt/sys 2>/dev/null || log_warn "Falha ao desmontar /mnt/sys"
	fi

	# Export pool se importado
	if zpool list "${POOL_NAME}" &>/dev/null; then
		log_info "Exportando pool ${POOL_NAME}"
		if zpool export "${POOL_NAME}" 2>/dev/null; then
			log_info "Pool ${POOL_NAME} exportado com sucesso"
		else
			log_warn "Falha ao exportar pool ${POOL_NAME}"
		fi
	fi

	log_info "Cleanup finalizado"
	exit "${exit_code}"
}

cleanup_interrupted() {
	printf '\n\n%s\n' "$(gum style --foreground "${DS_WARNING}" "Instalação interrompida pelo usuário")"
	cleanup
}

trap cleanup EXIT
trap cleanup_interrupted INT TERM


samba-vfs-modules
samba-dsdb-modules
winbind
libnss-winbind
libpam-winbind
# NOTA: libpam-smbpass removido - pacote descontinuado no Samba 4 (Debian Trixie)
cifs-utils

# === Integração Active Directory (realmd/sssd + winbind) =====================

libnss-systemd

# === Infraestrutura Essencial (NTP, DNS, Rede) ===============================
chrony
dnsutils
bind9-host
ethtool
irqbalance
sysfsutils

# === Database Tools (RECOMENDADO para debug Samba) ===========================
db-util


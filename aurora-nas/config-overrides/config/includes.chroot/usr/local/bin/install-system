#        gum style --foreground "$DS_WARNING" "  Modo: Disco Único (Sem redundância)"
#    fi
#}

# ═══════════════════════════════════════════════════════════════════════════════
# LÓGICA DE DISCO AVANÇADA (RAIDZ SUPPORT)
# ═══════════════════════════════════════════════════════════════════════════════

setup_disks() {
    hero_header "AURORA" "Configuração de Armazenamento"
    section_header "Seleção de Dispositivos"
    
    # 1. Seleção Múltipla de Discos
    DISK_LIST=$(lsblk -dno NAME,SIZE,MODEL | grep -v "loop" | awk '{print $1" ("$2") - "$3}')
    SELECTED=$(echo "$DISK_LIST" | gum choose --no-limit --header "Selecione os discos (Espaço para marcar, Enter para confirmar)")
    
    COUNT=$(echo "$SELECTED" | wc -l)
    DISKS=$(echo "$SELECTED" | awk '{print "/dev/"$1}' | tr '\n' ' ')
    
    if [ -z "$SELECTED" ]; then
        error_box "Nenhum disco selecionado. A instalação não pode prosseguir."
        exit 1
    fi

    # 2. Definição Dinâmica de Níveis de RAID
    OPTIONS=("Single (1 disco)")
    [ "$COUNT" -ge 2 ] && OPTIONS+=("Mirror (2+ discos)")
    [ "$COUNT" -ge 3 ] && OPTIONS+=("RAIDZ1 (Mínimo 3 discos)")
    [ "$COUNT" -ge 4 ] && OPTIONS+=("RAIDZ2 (Mínimo 4 discos)")
    [ "$COUNT" -ge 5 ] && OPTIONS+=("RAIDZ3 (Mínimo 5 discos)")

    section_header "Nível de Redundância"
    status_info "Discos selecionados: $COUNT"
    
    RAID_CHOICE=$(printf '%s\n' "${OPTIONS[@]}" | gum choose --header "Escolha o layout do Pool ZFS")

    # 3. Mapeamento para Comandos ZFS
    case "$RAID_CHOICE" in
        "Mirror"*)  VDEV_TYPE="mirror" ;;
        "RAIDZ1"*)  VDEV_TYPE="raidz1" ;;
        "RAIDZ2"*)  VDEV_TYPE="raidz2" ;;
        "RAIDZ3"*)  VDEV_TYPE="raidz3" ;;
        *)          VDEV_TYPE="" ;; # Single
    esac

    info_card "Configuração Confirmada" \
        "$(list_item "Discos" "$COUNT")" \
        "$(list_item "Layout" "$RAID_CHOICE")" \
        "$(list_item "VDEV" "${VDEV_TYPE:-stripe}")"
}

# 2. Execução da Instalação (Os Gaps Resolvidos)
run_install() {
    hero_header "AURORA" "Instalando Sistema Base"
    local total=8; local step=0

    # [Step 3] Criação do Pool e Datasets com NFSv4 ACLs
    ((step++)); progress_bar $step $total "Criando Pool ZFS com NFSv4 ACLs"
    zpool create -f $ZFS_OPTS -R /mnt $POOL_NAME $VDEV_TYPE $DISKS

    # Criando datasets separados para isolamento de dados
    zfs create -o mountpoint=none $POOL_NAME/ROOT
    zfs create -o mountpoint=/ -o canmount=noauto $POOL_NAME/ROOT/debian
    zfs create -o mountpoint=/home $POOL_NAME/home
    # Dataset de dados com paridade absoluta ao FreeNAS
    zfs create -o mountpoint=/srv/dados -o acltype=nfsv4 $POOL_NAME/dados
    zpool set bootfs=$POOL_NAME/ROOT/debian $POOL_NAME

    # [Step 7] Tuning de Kernel e Configuração AD
    ((step++)); progress_bar $step $total "Aplicando Tuning de Kernel e Samba AD"

    # Injetando Tuning de Kernel (Gap 2.1 resolvido)
    mkdir -p /mnt/etc/sysctl.d
    cat <<EOF > /mnt/etc/sysctl.d/99-nas-performance.conf
vm.swappiness=10
vm.min_free_kbytes=65536
net.core.rmem_max=16777216
net.core.wmem_max=16777216
fs.inotify.max_user_watches=524288
EOF

    # Configuração Winbind RID (Paridade de IDs FreeNAS)
    mkdir -p /mnt/etc/samba
    cat <<EOF > /mnt/etc/samba/smb.conf
[global]
   workgroup = AURORANET
   security = ads
   realm = AURORANET.AURORA.GOV.BR
   idmap config * : backend = tdb
   idmap config * : range = 3000-7999
   idmap config AURORANET : backend = rid
   idmap config AURORANET : range = 10000-999999
   vfs objects = acl_xattr
   map acl inherit = yes
   store dos attributes = yes
   strict sync = no
EOF

    # [Step 8] Finalização no Chroot
    ((step++)); progress_bar $step $total "Finalizando no Chroot"
    # (Montagens de bind e comandos de useradd omitidos para brevidade, mas devem seguir o original)
}

# Início
setup_disks
run_install

 #!/usr/bin/env bash
#
# Instalador AURORA TUI - Debian 13 (Trixie) NAS
# Foco: ZFS NFSv4 ACLs, Samba AD Winbind RID e Performance
#

set -e

# ═══════════════════════════════════════════════════════════════════════════════
# DESIGN SYSTEM v2.0 - HARMONIA SLATE-AURORA
# ═══════════════════════════════════════════════════════════════════════════════
DS_VOID=235; DS_DEPTH=237; DS_ELEVATION=239
DS_WHISPER=240; DS_MIST=243; DS_FOG=245; DS_HAZE=248; DS_CLOUD=250; DS_SILVER=252
DS_SLATE=67; DS_SLATE_GLOW=68; DS_AURORA_PEAK=153
DS_SUCCESS=108; DS_WARNING=179; DS_ERROR=167
UI_H='─'; UI_ARROW='▶'; UI_BULLET='●'; UI_CHECK='✓'; UI_WARN='⚠'

# ═══════════════════════════════════════════════════════════════════════════════
# CONFIGURAÇÕES TÉCNICAS (ESTRELA DO NORTE)
# ═══════════════════════════════════════════════════════════════════════════════
POOL_NAME="rpool"
# Opções ZFS focadas em paridade FreeNAS e performance Linux
ZFS_OPTS="-o ashift=12 -O compression=lz4 -O xattr=sa -O dnodesize=auto -O normalization=formD -O mountpoint=none -O canmount=off"

# ═══════════════════════════════════════════════════════════════════════════════
# COMPONENTES DE UI (ABSTRAÇÃO)
# ═══════════════════════════════════════════════════════════════════════════════
hero_header() {
    clear
    gum style --foreground "$DS_AURORA_PEAK" --border-foreground "$DS_SLATE" --border double \
        --align center --width 60 --margin "1 2" --padding "1 2" "${1:-AURORA INSTALLER}" "${2:-Debian ZFS NAS}"
}

section_header() {
    echo ""; gum style --foreground "$DS_MIST" --bold "$(printf "${UI_H}%.0s" $(seq 1 60))"
    gum style --foreground "$DS_SILVER" --bold "  ${UI_ARROW} $1"
    gum style --foreground "$DS_MIST" --bold "$(printf "${UI_H}%.0s" $(seq 1 60))"
}

progress_bar() {
    local filled=$(( $1 * 40 / $2 )); local pct=$(( $1 * 100 / $2 ))
    echo ""; gum style --foreground "$DS_SLATE" "  [$(printf '█%.0s' $(seq 1 $filled))$(printf '░%.0s' $(seq 1 $((40-filled))))] ${pct}%"
    gum style --foreground "$DS_FOG" --italic "      ${UI_ARROW} $3"
}

# ═══════════════════════════════════════════════════════════════════════════════
# FLUXO DE INSTALAÇÃO
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Boas-vindas e Seleção de Disco (Suporte a Mirror opcional)
